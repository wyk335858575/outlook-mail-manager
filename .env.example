APP_BASE_URL=http://localhost:8080
APP_LISTEN_ADDR=:8080
APP_DATA_DIR=/data
APP_LOG_LEVEL=info
APP_VERSION=1.1.0
# Go 运行时软内存上限；为 SQLite、TLS 和系统页缓存保留容器余量。
GOMEMLIMIT=512MiB
GOGC=75
# Fork 部署时替换为自己的仓库和镜像；在线更新会原子改为已签名的固定 digest。
APP_UPDATE_REPOSITORY=wyk335858575/outlook-mail-manager
APP_IMAGE=ghcr.io/wyk335858575/outlook-mail-manager:1.1.0
# 可选：首次启动默认值，也可登录后在“设置”中保存
MS_CLIENT_ID=
